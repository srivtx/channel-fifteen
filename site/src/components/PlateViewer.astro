---
// The plate viewer: a plate grows out of the page into a dark light-table,
// where it can be zoomed, dragged and paged through, then shrinks back.
---

<dialog class="pv" aria-label="Plate viewer">
  <div class="pv-bar mono">
    <span class="pv-no"></span>
    <span class="pv-cap"></span>
    <span class="pv-tools">
      <button class="pv-btn" data-act="out" aria-label="Zoom out">−</button>
      <button class="pv-btn pv-zoom" data-act="fit" aria-label="Fit to screen">100%</button>
      <button class="pv-btn" data-act="in" aria-label="Zoom in">+</button>
      <a class="pv-btn pv-open" target="_blank" rel="noopener" aria-label="Open the plate file">↗</a>
      <button class="pv-btn pv-x" data-act="close" aria-label="Close">✕</button>
    </span>
  </div>
  <div class="pv-stage">
    <img class="pv-img" alt="" draggable="false" />
  </div>
  <button class="pv-nav pv-prev" data-act="prev" aria-label="Previous plate">←</button>
  <button class="pv-nav pv-next" data-act="next" aria-label="Next plate">→</button>
  <div class="pv-foot mono"><span class="pv-count"></span><span class="pv-hint">scroll or pinch to zoom · drag to move · ← → to page · esc to close</span></div>
</dialog>

<style is:global>
  /* Each plate on the page carries a badge that says it opens. */
  .plate-fig { position: relative; display: block; cursor: zoom-in; margin: 0; }
  .plate-fig::after {
    content: "⤢ ENLARGE"; position: absolute; top: 12px; right: 12px; padding: 5px 9px;
    font: 600 10px var(--mono); letter-spacing: 0.14em; color: var(--bone); background: var(--night);
    border-radius: 3px; opacity: 0; transform: translateY(-4px); transition: opacity 0.2s, transform 0.2s;
  }
  .plate-fig:hover::after, .plate-fig:focus-visible::after { opacity: 1; transform: none; }
  .plate-fig:focus-visible { outline: none; }
  .plate-fig:focus-visible img { outline: 3px solid var(--accent, var(--verm)); outline-offset: 4px; }
  .plate-fig img { transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.25s; }
  .plate-fig:hover img { transform: translate(-3px, -3px); box-shadow: 11px 11px 0 color-mix(in srgb, var(--accent, var(--verm)) 85%, transparent); }
  .plate-cap { display: flex; gap: 12px; align-items: baseline; margin-top: 16px; font: 500 12px/1.4 var(--mono); color: var(--muted); letter-spacing: 0.04em; }
  .plate-cap b { color: var(--accent, var(--verm)); font-weight: 600; letter-spacing: 0.14em; white-space: nowrap; }
  .plate-fig.is-away img { visibility: hidden; }
  html.pv-lock { overflow: hidden; }

  .pv {
    --pv-accent: var(--signal);
    position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: transparent; color: var(--bone); overflow: hidden;
  }
  .pv::backdrop { background: transparent; }
  .pv::before {
    content: ""; position: absolute; inset: 0; background-color: rgba(18, 17, 16, 0.97); backdrop-filter: blur(6px);
    background-image: radial-gradient(circle, rgba(239, 232, 216, 0.09) 1px, transparent 1.3px);
    background-size: 14px 14px; opacity: 0; transition: opacity 0.32s ease;
  }
  .pv.on::before { opacity: 1; }
  .pv-bar, .pv-foot, .pv-nav { opacity: 0; transition: opacity 0.25s ease 0.1s, transform 0.25s ease 0.1s; }
  .pv.on .pv-bar, .pv.on .pv-foot, .pv.on .pv-nav { opacity: 1; }
  .pv-bar {
    position: absolute; z-index: 2; top: 0; left: 0; right: 0; display: flex; align-items: center; gap: 16px;
    padding: 14px 18px; font-size: 12px; letter-spacing: 0.06em; transform: translateY(-8px);
    border-bottom: 1px solid rgba(239, 232, 216, 0.14);
  }
  .pv.on .pv-bar { transform: none; }
  .pv-no { color: var(--pv-accent); font-weight: 600; letter-spacing: 0.16em; white-space: nowrap; }
  .pv-cap { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--sans); font-size: 15px; font-weight: 500; letter-spacing: 0; }
  .pv-tools { display: flex; gap: 6px; }
  .pv-btn {
    min-width: 34px; height: 34px; padding: 0 9px; display: inline-grid; place-items: center; border-radius: 6px;
    border: 1px solid rgba(239, 232, 216, 0.3); background: transparent; color: var(--bone);
    font: 600 13px var(--mono); cursor: pointer; text-decoration: none; transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .pv-btn:hover, .pv-btn:focus-visible { border-color: var(--pv-accent); color: var(--pv-accent); outline: none; }
  .pv-zoom { min-width: 62px; }
  .pv-x { background: var(--bone); color: var(--night); border-color: var(--bone); }
  .pv-x:hover, .pv-x:focus-visible { background: var(--pv-accent); border-color: var(--pv-accent); color: var(--night); }
  .pv-stage { position: absolute; inset: 0; touch-action: none; cursor: grab; }
  .pv-stage.drag { cursor: grabbing; }
  .pv-img {
    position: absolute; left: 0; top: 0; transform-origin: 0 0; max-width: none; user-select: none;
    background: #efe8d8; border-radius: 3px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .pv-nav {
    position: absolute; z-index: 2; top: 50%; width: 46px; height: 46px; margin-top: -23px; border-radius: 50%;
    border: 1px solid rgba(239, 232, 216, 0.3); background: rgba(18, 17, 16, 0.6); color: var(--bone);
    font: 600 18px var(--mono); cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s, opacity 0.25s;
  }
  .pv-nav:hover, .pv-nav:focus-visible { background: var(--pv-accent); border-color: var(--pv-accent); color: var(--night); outline: none; }
  .pv-nav[hidden] { display: none; }
  .pv-prev { left: 18px; }
  .pv-next { right: 18px; }
  .pv-foot {
    position: absolute; z-index: 2; bottom: 0; left: 0; right: 0; display: flex; justify-content: space-between; gap: 16px;
    padding: 12px 18px; font-size: 11px; letter-spacing: 0.1em; color: rgba(239, 232, 216, 0.6); text-transform: uppercase;
  }
  .pv-count { color: var(--pv-accent); }
  @media (max-width: 700px) {
    .pv-cap { display: none; }
    .pv-bar { justify-content: space-between; }
    .pv-hint { display: none; }
    .pv-nav { top: auto; bottom: 10px; margin: 0; }
    .pv-foot { justify-content: center; padding: 22px; }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>(".pv")!;
  const stage = dlg.querySelector<HTMLElement>(".pv-stage")!;
  const img = dlg.querySelector<HTMLImageElement>(".pv-img")!;
  const no = dlg.querySelector<HTMLElement>(".pv-no")!;
  const cap = dlg.querySelector<HTMLElement>(".pv-cap")!;
  const count = dlg.querySelector<HTMLElement>(".pv-count")!;
  const zoomLabel = dlg.querySelector<HTMLElement>(".pv-zoom")!;
  const openLink = dlg.querySelector<HTMLAnchorElement>(".pv-open")!;
  const prevBtn = dlg.querySelector<HTMLButtonElement>(".pv-prev")!;
  const nextBtn = dlg.querySelector<HTMLButtonElement>(".pv-next")!;
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)";

  // Wrap every plate in the chapter: a focusable figure with a numbered caption.
  type Plate = { fig: HTMLElement; img: HTMLImageElement; label: string; title: string };
  const plates: Plate[] = [];
  for (const el of document.querySelectorAll<HTMLImageElement>(".prose p > img")) {
    const p = el.parentElement!;
    const fig = document.createElement("figure");
    fig.className = "plate-fig";
    fig.tabIndex = 0;
    fig.id = `plate-${el.getAttribute("src")!.split("/").pop()!.slice(0, 2)}`;
    fig.setAttribute("role", "button");
    const file = el.getAttribute("src")!.split("/").pop()!;
    const label = `PLATE ${file.slice(0, 2)}`;
    fig.setAttribute("aria-label", `Enlarge ${label}: ${el.alt}`);
    const caption = document.createElement("figcaption");
    caption.className = "plate-cap";
    caption.innerHTML = `<b>${label}</b><span></span>`;
    caption.querySelector("span")!.textContent = el.alt;
    p.replaceWith(fig);
    fig.append(el, caption);
    fig.classList.add("reveal");
    plates.push({ fig, img: el, label, title: el.alt });
  }

  // View state: the plate's natural size, and a scale and offset on screen.
  let at = -1;
  let natW = 1, natH = 1;
  let s = 1, x = 0, y = 0, fit = 1;
  let busy = false;

  const pad = () => (innerWidth < 700 ? { t: 64, b: 76, l: 12, r: 12 } : { t: 76, b: 56, l: 84, r: 84 });
  function fitView() {
    const p = pad();
    const w = innerWidth - p.l - p.r, h = innerHeight - p.t - p.b;
    fit = Math.min(w / natW, h / natH);
    s = fit;
    x = p.l + (w - natW * s) / 2;
    y = p.t + (h - natH * s) / 2;
  }
  function apply() {
    img.style.transform = `translate(${x}px, ${y}px) scale(${s})`;
    zoomLabel.textContent = `${Math.round((s / fit) * 100)}%`;
  }
  // Keep a zoomed plate from being dragged off screen.
  function clamp() {
    const w = natW * s, h = natH * s, p = pad();
    const cx = (innerWidth - w) / 2, cy = (p.t + innerHeight - p.b - h) / 2;
    x = w <= innerWidth ? cx : Math.min(0, Math.max(innerWidth - w, x));
    y = h <= innerHeight - p.t - p.b ? cy : Math.min(p.t, Math.max(innerHeight - p.b - h, y));
  }
  function zoomAt(k: number, px = innerWidth / 2, py = innerHeight / 2, smooth = false) {
    const next = Math.min(fit * 8, Math.max(fit, s * k));
    x = px - ((px - x) * next) / s;
    y = py - ((py - y) * next) / s;
    s = next;
    clamp();
    img.style.transition = smooth && !calm ? `transform 0.28s ${EASE}` : "none";
    apply();
  }

  function sizeOf(el: HTMLImageElement) {
    natW = el.naturalWidth || 1600;
    natH = el.naturalHeight || 1000;
    img.style.width = `${natW}px`;
    img.style.height = `${natH}px`;
  }
  function label(i: number) {
    const pl = plates[i];
    no.textContent = pl.label;
    cap.textContent = pl.title;
    count.textContent = `${String(i + 1).padStart(2, "0")} / ${String(plates.length).padStart(2, "0")}`;
    openLink.href = pl.img.currentSrc || pl.img.src;
    img.alt = pl.title;
    prevBtn.hidden = i === 0;
    nextBtn.hidden = i === plates.length - 1;
    dlg.style.setProperty("--pv-accent", readable(getComputedStyle(pl.fig).getPropertyValue("--accent").trim()));
  }
  // The chapter's ink, unless it is too dark to read on the light-table.
  function readable(hex: string) {
    const m = hex.match(/^#([0-9a-f]{6})$/i);
    if (!m) return "var(--signal)";
    const n = parseInt(m[1], 16);
    const lum = (0.2126 * (n >> 16) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255)) / 255;
    return lum > 0.4 ? hex : "var(--signal)";
  }
  // The transform that lays the viewer image exactly over the plate on the page.
  function onPage(i: number) {
    const r = plates[i].img.getBoundingClientRect();
    return `translate(${r.left}px, ${r.top}px) scale(${r.width / natW})`;
  }

  async function open(i: number) {
    if (busy || !plates.length) return;
    busy = true;
    at = i;
    const pl = plates[i];
    img.src = pl.img.currentSrc || pl.img.src;
    sizeOf(pl.img);
    label(i);
    document.documentElement.classList.add("pv-lock");
    dlg.showModal();
    fitView();
    if (!calm) {
      img.style.transition = "none";
      img.style.transform = onPage(i);
      pl.fig.classList.add("is-away");
      img.getBoundingClientRect();
      img.style.transition = `transform 0.5s ${EASE}`;
    }
    dlg.classList.add("on");
    apply();
    setTimeout(() => { busy = false; }, calm ? 0 : 500);
  }

  function close() {
    if (busy || at < 0) return;
    busy = true;
    const pl = plates[at];
    dlg.classList.remove("on");
    // Bring the plate into view first so the image has somewhere to land.
    const r = pl.img.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) pl.fig.scrollIntoView({ block: "center" });
    if (location.hash.startsWith("#plate-")) history.replaceState(null, "", location.pathname + location.search);
    const done = () => {
      pl.fig.classList.remove("is-away");
      dlg.close();
      document.documentElement.classList.remove("pv-lock");
      pl.fig.focus({ preventScroll: true });
      at = -1;
      busy = false;
    };
    if (calm) return done();
    pl.fig.classList.add("is-away");
    img.style.transition = `transform 0.42s ${EASE}`;
    img.style.transform = onPage(at);
    setTimeout(done, 420);
  }

  // Paging slides the current plate out and the next one in.
  function go(d: number) {
    const i = at + d;
    if (busy || i < 0 || i >= plates.length) return;
    busy = true;
    const out = calm ? 0 : 180;
    img.style.transition = `transform ${out}ms ease-in, opacity ${out}ms ease-in`;
    img.style.opacity = "0";
    img.style.transform = `translate(${x - d * 80}px, ${y}px) scale(${s})`;
    setTimeout(() => {
      at = i;
      const pl = plates[i];
      img.src = pl.img.currentSrc || pl.img.src;
      sizeOf(pl.img);
      label(i);
      fitView();
      img.style.transition = "none";
      img.style.transform = `translate(${x + d * 80}px, ${y}px) scale(${s})`;
      img.getBoundingClientRect();
      img.style.transition = `transform 0.32s ${EASE}, opacity 0.32s ease`;
      img.style.opacity = "1";
      apply();
      setTimeout(() => { busy = false; }, calm ? 0 : 320);
    }, out);
  }

  for (const [i, pl] of plates.entries()) {
    pl.fig.addEventListener("click", () => open(i));
    pl.fig.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(i); }
    });
  }

  // #plate-09 in the address (from search, or a shared link) opens that plate.
  function fromHash() {
    const i = plates.findIndex((pl) => `#${pl.fig.id}` === location.hash);
    if (i < 0 || at >= 0) return;
    plates[i].fig.scrollIntoView({ block: "center" });
    plates[i].fig.classList.add("in");
    setTimeout(() => open(i), 350);
  }
  addEventListener("hashchange", fromHash);
  fromHash();

  dlg.addEventListener("click", (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>("[data-act]")?.dataset.act;
    if (act === "close") close();
    else if (act === "prev") go(-1);
    else if (act === "next") go(1);
    else if (act === "in") zoomAt(1.6, innerWidth / 2, innerHeight / 2, true);
    else if (act === "out") zoomAt(1 / 1.6, innerWidth / 2, innerHeight / 2, true);
    else if (act === "fit") { fitView(); img.style.transition = calm ? "none" : `transform 0.28s ${EASE}`; apply(); }
  });
  dlg.addEventListener("cancel", (e) => { e.preventDefault(); close(); });
  dlg.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") go(1);
    else if (e.key === "ArrowLeft") go(-1);
    else if (e.key === "+" || e.key === "=") zoomAt(1.6, innerWidth / 2, innerHeight / 2, true);
    else if (e.key === "-") zoomAt(1 / 1.6, innerWidth / 2, innerHeight / 2, true);
    else if (e.key === "0") dlg.querySelector<HTMLElement>("[data-act=fit]")!.click();
  });
  stage.addEventListener("wheel", (e) => {
    e.preventDefault();
    zoomAt(Math.exp(-e.deltaY * (e.ctrlKey ? 0.01 : 0.0022)), e.clientX, e.clientY);
  }, { passive: false });
  stage.addEventListener("dblclick", (e) => {
    if (s > fit * 1.05) { fitView(); img.style.transition = calm ? "none" : `transform 0.3s ${EASE}`; apply(); }
    else zoomAt(2.5, e.clientX, e.clientY, true);
  });

  // Pointers: one finger or the mouse drags, two fingers pinch; a quick tap on
  // the dark table closes, and a fast sideways flick at fit size pages.
  const pts = new Map<number, { x: number; y: number }>();
  let start = { x: 0, y: 0, t: 0, moved: false };
  let pinch = 0;
  stage.addEventListener("pointerdown", (e) => {
    try { stage.setPointerCapture(e.pointerId); } catch {}
    pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pts.size === 1) start = { x: e.clientX, y: e.clientY, t: performance.now(), moved: false };
    if (pts.size === 2) {
      const [a, b] = [...pts.values()];
      pinch = Math.hypot(a.x - b.x, a.y - b.y);
    }
    img.style.transition = "none";
  });
  stage.addEventListener("pointermove", (e) => {
    const prev = pts.get(e.pointerId);
    if (!prev) return;
    const cur = { x: e.clientX, y: e.clientY };
    pts.set(e.pointerId, cur);
    if (Math.hypot(cur.x - start.x, cur.y - start.y) > 6) start.moved = true;
    if (pts.size === 2) {
      const [a, b] = [...pts.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch) zoomAt(d / pinch, (a.x + b.x) / 2, (a.y + b.y) / 2);
      pinch = d;
    } else if (s > fit * 1.01) {
      stage.classList.add("drag");
      x += cur.x - prev.x;
      y += cur.y - prev.y;
      clamp();
      apply();
    }
  });
  const up = (e: PointerEvent) => {
    if (!pts.delete(e.pointerId)) return;
    stage.classList.remove("drag");
    pinch = 0;
    if (pts.size) return;
    const dx = e.clientX - start.x, dt = performance.now() - start.t;
    if (s <= fit * 1.01 && Math.abs(dx) > 60 && dt < 400) go(dx < 0 ? 1 : -1);
    else if (!start.moved && dt < 300 && e.target !== img) close();
  };
  stage.addEventListener("pointerup", up);
  stage.addEventListener("pointercancel", up);
  addEventListener("resize", () => { if (at >= 0) { fitView(); img.style.transition = "none"; apply(); } });
</script>
