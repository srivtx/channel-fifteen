---
// The cover: a poster on night paper. The earbud is drawn out of the bytes it actually sent,
// in a dot-matrix that keeps rewriting itself; a scan line sweeps it like a reader.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero" data-base={base}>
  <div class="crop tl"></div><div class="crop tr"></div><div class="crop bl"></div><div class="crop br"></div>

  <p class="meta a mono">REF // RFCOMM CH 15 → NOW<br /><span>#</span> the buds remember what the mac forgot</p>
  <p class="meta b mono">FIG. 00 — SPECIMEN<br />TWS EARBUD · DRAWN IN ITS OWN BYTES</p>
  <p class="meta c mono"><span>[ ]</span> a hidden serial port<br /><span>[ ]</span> nine bytes to ask<br /><span>[x]</span> left 10 %</p>

  <div class="art">
    <canvas aria-label="An earbud drawn out of hex bytes"></canvas>
    <span class="glyphs g1 mono" aria-hidden="true">+ + = × AA 07 → ÷ + ×</span>
    <span class="glyphs g2 mono" aria-hidden="true">← 81 00 06 = + 0A ×</span>
  </div>

  <h1 class="word pixel" aria-label="Channel Fifteen">CHANNEL<span>FIFTEEN</span></h1>

  <div class="block">
    <p class="lede">
      How a Mac learned to talk to a pair of earbuds — told as a story, explained from first principles:
      sound, electrons, radio, Bluetooth, bytes, protocols, Swift and shipping.
    </p>
    <table class="tb mono">
      <tr><th>SUBJECT</th><td>realme Buds Air 7</td><th>DOOR</th><td>RFCOMM 15</td></tr>
      <tr><th>CHAPTERS</th><td>13</td><th>PLATES</th><td>43</td></tr>
      <tr><th>MODEL</th><td>Blender, 21 parts</td><th>BRANDS</th><td>7</td></tr>
    </table>
    <div class="cta">
      <a class="go" href="#story">Begin the story ↓</a>
      <a class="go ghost" href={`${base}/chapters/00-prologue/`}>Read the prologue</a>
    </div>
  </div>

  <div class="scan mono"><i></i>SCAN COMPLETE · 00:00:07</div>
  <div class="ticker mono" aria-hidden="true"><span>AA 07 00 00 06 01 00 00 00 → AA 0D 00 00 06 81 00 06 00 00 02 01 0A 03 00 ← AA 07 00 00 09 01 02 00 00 → AA 0B 00 00 0C 81 03 04 00 00 01 01 08 ← </span><span>AA 07 00 00 06 01 00 00 00 → AA 0D 00 00 06 81 00 06 00 00 02 01 0A 03 00 ← AA 07 00 00 09 01 02 00 00 → AA 0B 00 00 0C 81 03 04 00 00 01 01 08 ← </span></div>
</section>

<style>
  .hero {
    --fg: var(--bone); position: relative; background: var(--night); color: var(--fg); overflow: hidden;
    height: calc(100svh - 58px); min-height: 620px; display: grid; padding: 54px 24px 70px; gap: 18px 28px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto; grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas: "a art word" "c art word" "block block word";
  }
  .hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.09;
    background: radial-gradient(circle, var(--fg) 1px, transparent 1.3px) 0 0 / 8px 8px; }
  .crop { position: absolute; width: 18px; height: 18px; border: 0 solid var(--fg); opacity: 0.7; }
  .tl { top: 14px; left: 14px; border-width: 1.5px 0 0 1.5px; } .tr { top: 14px; right: 14px; border-width: 1.5px 1.5px 0 0; }
  .bl { bottom: 14px; left: 14px; border-width: 0 0 1.5px 1.5px; } .br { bottom: 14px; right: 14px; border-width: 0 1.5px 1.5px 0; }
  .meta { position: relative; margin: 0; font-size: 11px; line-height: 1.6; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.9; }
  .meta span { color: var(--magenta); }
  .a { grid-area: a; } .c { grid-area: c; align-self: center; text-transform: none; letter-spacing: 0.04em; font-size: 13px; }
  .c span { color: var(--phosphor); }
  .b { position: absolute; top: 54px; right: calc(24px + 2 * min(8.5vw, calc((100svh - 190px) / 7.4)) + 30px); text-align: right; }
  .art { grid-area: art; position: relative; min-height: 0; margin-top: 44px; }
  .art canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .glyphs { position: absolute; color: var(--phosphor); font-size: 13px; letter-spacing: 0.2em; white-space: nowrap; }
  .g1 { left: 2%; top: 22%; } .g2 { right: 4%; bottom: 18%; color: var(--magenta); }
  .word {
    grid-area: word; margin: 0; writing-mode: vertical-rl; transform: rotate(180deg); justify-self: end;
    font-size: min(8.5vw, calc((100svh - 190px) / 7.4)); line-height: 0.9; letter-spacing: -0.02em; color: var(--fg); white-space: nowrap; align-self: center;
  }
  .word span { display: block; color: var(--magenta); }
  .block { grid-area: block; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 28px; align-items: end; position: relative; }
  .lede { margin: 0; font-size: clamp(17px, 1.8vw, 21px); line-height: 1.5; max-width: 560px; }
  .tb { border-collapse: collapse; font-size: 11px; width: 100%; border: 1.5px solid var(--fg); }
  .tb th, .tb td { border: 1px solid color-mix(in srgb, var(--fg) 55%, transparent); padding: 5px 8px; text-align: left; }
  .tb th { font-weight: 500; opacity: 0.7; letter-spacing: 0.1em; width: 1%; white-space: nowrap; }
  .tb td { color: var(--phosphor); }
  .cta { grid-column: 1 / -1; display: flex; gap: 12px; flex-wrap: wrap; }
  .go { font: 600 13px var(--mono); text-decoration: none; padding: 11px 16px; background: var(--magenta); color: var(--night); border: 1.5px solid var(--magenta); box-shadow: 5px 5px 0 var(--phosphor); }
  .go:hover { color: var(--night); transform: translate(-1px, -1px); }
  .go.ghost { background: transparent; color: var(--fg); border-color: var(--fg); box-shadow: none; }
  .go.ghost:hover { color: var(--magenta); border-color: var(--magenta); }
  .scan { position: absolute; left: 24px; bottom: 40px; font-size: 10px; letter-spacing: 0.2em; display: flex; gap: 10px; align-items: center; opacity: 0.8; }
  .scan i { width: 90px; height: 14px; background: repeating-linear-gradient(90deg, var(--fg) 0 2px, transparent 2px 4px, var(--fg) 4px 5px, transparent 5px 8px, var(--fg) 8px 11px, transparent 11px 13px); }
  .ticker { position: absolute; left: 0; right: 0; bottom: 0; height: 28px; display: flex; overflow: hidden; border-top: 1.5px solid var(--fg); background: var(--phosphor); color: var(--night); font-size: 12px; font-weight: 600; line-height: 28px; white-space: nowrap; }
  .ticker span { padding-right: 0; animation: tick 40s linear infinite; }
  @keyframes tick { to { transform: translateX(-100%); } }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto auto; grid-template-areas: "word" "a" "art" "block"; padding: 40px 16px 90px; }
    .hero { height: auto; min-height: 0; }
    .word { writing-mode: horizontal-tb; transform: none; justify-self: start; align-self: start; font-size: clamp(44px, 14vw, 96px); line-height: 0.9; white-space: normal; }
    .b, .c, .g2 { display: none; }
    .art { min-height: 0; margin-top: 0; aspect-ratio: 1 / 1; }
    .block { grid-template-columns: 1fr; gap: 16px; }
    .scan { bottom: 38px; left: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .ticker span { animation: none; } }
</style>

<script>
  const hero = document.querySelector<HTMLElement>(".hero")!;
  const canvas = hero.querySelector("canvas")!;
  const ctx = canvas.getContext("2d")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const BYTES = "AA 07 00 00 06 01 00 00 00 AA 0D 00 00 06 81 00 06 00 00 02 01 0A 03 00 AA 0B 00 00 0C 81 03 04 00 00 01 01 08".split(" ");
  const MAGENTA = "#ff3d8b", PHOSPHOR = "#4be08a", BONE = "#efe8d8";

  type Cell = { x: number; y: number; lum: number; edge: boolean; byte: string; shift: number };
  let cells: Cell[] = [];
  let cs = 10, cols = 0, rows = 0, ox = 0, oy = 0;
  const img = new Image();
  img.src = `${hero.dataset.base}/art/bud-mask.png`;

  function sample() {
    const r = canvas.getBoundingClientRect();
    const dpr = Math.min(devicePixelRatio, 2);
    canvas.width = r.width * dpr;
    canvas.height = r.height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    // Fit the bud inside the box, then cut it into cells of a size that reads as type.
    const fitH = Math.min(r.height, (r.width * img.height) / img.width) * 0.94;
    cs = Math.max(7, Math.round(fitH / 62));
    rows = Math.floor(fitH / cs);
    cols = Math.floor((rows * img.width) / img.height);
    ox = (r.width - cols * cs) / 2;
    oy = (r.height - rows * cs) / 2;
    const off = document.createElement("canvas");
    off.width = cols;
    off.height = rows;
    const o = off.getContext("2d")!;
    o.drawImage(img, 0, 0, cols, rows);
    const d = o.getImageData(0, 0, cols, rows).data;
    const alpha = (x: number, y: number) => (x < 0 || y < 0 || x >= cols || y >= rows ? 0 : d[(y * cols + x) * 4 + 3]);
    cells = [];
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const i = (y * cols + x) * 4;
        if (d[i + 3] < 110) continue;
        const lum = (0.3 * d[i] + 0.59 * d[i + 1] + 0.11 * d[i + 2]) / 255;
        const edge = alpha(x - 1, y) < 110 || alpha(x + 1, y) < 110 || alpha(x, y - 1) < 110 || alpha(x, y + 1) < 110;
        cells.push({ x, y, lum, edge, byte: BYTES[(x * 7 + y * 3) % BYTES.length], shift: 0 });
      }
    }
    // A few rows slip sideways, like a misregistered print.
    const slips = new Set(Array.from({ length: 5 }, () => Math.floor(Math.random() * rows)));
    for (const c of cells) if (slips.has(c.y)) c.shift = (c.y % 2 ? 1 : -1) * cs * 1.5;
  }

  let mx = -1e4, my = -1e4;
  hero.addEventListener("pointermove", (e) => {
    const r = canvas.getBoundingClientRect();
    mx = e.clientX - r.left;
    my = e.clientY - r.top;
  });
  hero.addEventListener("pointerleave", () => (mx = my = -1e4));

  function draw(t: number) {
    const r = canvas.getBoundingClientRect();
    ctx.clearRect(0, 0, r.width, r.height);
    ctx.font = `600 ${cs * 0.62}px "IBM Plex Mono", Menlo, monospace`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    const scan = reduced ? -1 : ((t / 3800) % 1.3) * rows;
    for (const c of cells) {
      const px = ox + c.x * cs + c.shift, py = oy + c.y * cs;
      const near = Math.hypot(px - mx, py - my) < cs * 5;
      const inScan = Math.abs(c.y - scan) < 1.6;
      if (!reduced && Math.random() < 0.004) c.byte = BYTES[Math.floor(Math.random() * BYTES.length)];
      if (inScan || near) {
        ctx.fillStyle = PHOSPHOR;
        ctx.fillText(near ? "0x" : c.byte, px + cs / 2, py + cs / 2);
      } else if (c.edge) {
        ctx.fillStyle = BONE;
        ctx.fillRect(px + 1, py + 1, cs - 2, cs - 2);
      } else if (c.lum < 0.42) {
        ctx.fillStyle = MAGENTA;
        ctx.fillRect(px + 0.5, py + 0.5, cs - 1, cs - 1);
      } else if (c.lum < 0.62) {
        ctx.fillStyle = MAGENTA;
        ctx.fillText(c.byte, px + cs / 2, py + cs / 2);
      } else {
        ctx.fillStyle = MAGENTA;
        const s = cs * 0.34;
        ctx.fillRect(px + (cs - s) / 2, py + (cs - s) / 2, s, s);
      }
    }
  }

  function loop(t: number) {
    draw(t);
    if (!reduced) requestAnimationFrame(loop);
  }
  img.onload = () => {
    sample();
    requestAnimationFrame(loop);
    new ResizeObserver(() => {
      sample();
      if (reduced) draw(0);
    }).observe(canvas);
  };
</script>
