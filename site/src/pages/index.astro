---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import BudStory from "../components/BudStory.astro";
import { chapters, number, name, firstPlate, blurb } from "../scripts/chapters";
import { ink } from "../scripts/inks";

const all = await chapters();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Channel Fifteen — the Earshot field manual">
  <Hero />
  <BudStory />

  <section id="chapters" class="chapters">
    <div class="wrap">
      <div class="head">
        <p class="kicker">contents · asset 000–012</p>
        <h2 class="pixel">THE CHAPTERS</h2>
        <p class="mono note">Each one opens where the story was, then goes all the way down.</p>
      </div>
      <div class="grid">
        {all.map((c, i) => {
          const plate = firstPlate(c);
          const k = ink(i);
          return (
            <a class="card" href={`${base}/chapters/${c.id}/`} style={`--bg:${k.bg};--fg:${k.fg};--accent:${k.accent}`}>
              <div class="cardtop">
                <span class="num pixel">{number(c)}</span>
                <span class="tag mono">ASSET – {String(i + 1).padStart(3, "0")}</span>
              </div>
              {plate && <div class="plate"><img src={`${base}/figures/${plate}`} alt="" loading="lazy" /></div>}
              <h3>{name(c)}</h3>
              <p>{blurb(c)}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  .chapters { padding: 14vh 0 12vh; border-top: 1.5px solid var(--text); }
  .head { display: grid; gap: 6px; margin-bottom: 34px; }
  .head h2 { font-size: clamp(40px, 8vw, 96px); line-height: 0.95; margin: 6px 0; }
  .note { margin: 0; color: var(--muted); font-size: 13px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 22px; }
  .card {
    display: flex; flex-direction: column; text-decoration: none; background: var(--bg); color: var(--fg);
    border: 1.5px solid var(--text); padding: 14px; box-shadow: 6px 6px 0 var(--text); transition: transform 0.15s, box-shadow 0.15s; min-width: 0;
  }
  .card:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--text); color: var(--fg); }
  .cardtop { display: flex; justify-content: space-between; align-items: flex-start; }
  .num { font-size: 54px; line-height: 0.9; color: transparent; -webkit-text-stroke: 1.5px var(--fg); }
  .card:hover .num { color: var(--accent); -webkit-text-stroke-color: var(--accent); }
  .tag { font-size: 10px; letter-spacing: 0.14em; opacity: 0.85; }
  .plate { margin: 14px 0 12px; background: #efe8d8; border: 1.5px solid var(--fg); aspect-ratio: 16 / 10; overflow: hidden; }
  .plate img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .card h3 { margin: 0 0 6px; font: 400 19px/1.2 var(--pixel); }
  .card p { margin: 0; font-size: 14px; line-height: 1.5; opacity: 0.88; }
</style>
