---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PacketDecoder from "../../components/PacketDecoder.astro";
import Hopping from "../../components/Hopping.astro";
import ExplodeViewer from "../../components/ExplodeViewer.astro";
import PlateViewer from "../../components/PlateViewer.astro";
import { chapters, title, number, name } from "../../scripts/chapters";
import { ink } from "../../scripts/inks";

export async function getStaticPaths() {
  const all = await chapters();
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, i, prev: all[i - 1], next: all[i + 1], all } }));
}

const { entry, i, prev, next, all } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const c = ink(i);
---

<Base title={`${title(entry)} — Channel Fifteen`}>
  <div class="readbar" aria-hidden="true" style={`--accent:${c.accent === "#121110" ? "#e0462f" : c.accent}`}><i></i></div>
  <header class="band" style={`--bg:${c.bg};--fg:${c.fg};--accent:${c.accent}`}>
    <div class="band-in">
      <p class="mono meta">CHAPTER {number(entry)} / {String(all.length - 1).padStart(2, "0")}<span> &nbsp;·&nbsp; CH.15 FIELD MANUAL</span></p>
      <span class="big pixel" aria-hidden="true" style={`view-transition-name: num-${entry.id.slice(0, 2)}`}>{number(entry)}</span>
      <h1 class="pixel">{name(entry)}</h1>
      <div class="code mono" aria-hidden="true"><i></i><span>REF {entry.id.toUpperCase()}</span></div>
    </div>
  </header>
  <div class="chapter" style={`--accent:${c.accent === "#121110" ? "#e0462f" : c.accent}`}>
    <aside class="toc" id="rail" aria-label="Chapters">
      <div class="toc-head mono"><span>CONTENTS · {all.length} CHAPTERS</span><button type="button" class="toc-x" aria-label="Close contents">✕</button></div>
      {all.map((ch) => (
        <a href={`${base}/chapters/${ch.id}/`} class={ch.id === entry.id ? "on" : ""}><b>{number(ch)}</b>{name(ch)}</a>
      ))}
      <a href={`${base}/decoder/`}><b>⌁</b>Packet decoder</a>
    </aside>
    <main>
      <article class="prose">
        <Content />
        {entry.id.startsWith("01") && <ExplodeViewer />}
        {entry.id.startsWith("03") && <Hopping />}
        {entry.id.startsWith("07") && <PacketDecoder />}
      </article>
      <nav class="pager">
        {prev ? <a class="pr" href={`${base}/chapters/${prev.id}/`}><small>← previous</small>{name(prev)}</a> : <span />}
        {next ? <a class="nx" href={`${base}/chapters/${next.id}/`}><small>next →</small>{name(next)}</a> : <a class="nx" href={`${base}/`}><small>the end ↑</small>Back to the story</a>}
      </nav>
    </main>
  </div>
  <button type="button" class="railbtn mono" aria-controls="rail" aria-expanded="false" style={`--accent:${c.accent === "#121110" ? "#e0462f" : c.accent}`}><i></i><b>{number(entry)}</b><span>{name(entry)}</span><em>▴</em></button>
  <div class="scrim" aria-hidden="true"></div>
  <PlateViewer />
</Base>

<style>
  .band { background: var(--bg); color: var(--fg); border-bottom: 1.5px solid var(--text); overflow: hidden; position: relative; }
  .band::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.18;
    background: radial-gradient(circle, var(--fg) 1.1px, transparent 1.4px) 0 0 / 9px 9px;
    -webkit-mask-image: linear-gradient(100deg, transparent 35%, #000 95%); mask-image: linear-gradient(100deg, transparent 35%, #000 95%); }
  .band-in { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 46px 16px 34px; min-height: 300px; display: flex; flex-direction: column; justify-content: flex-end; }
  .meta { font-size: 11px; letter-spacing: 0.14em; margin: 0 0 auto; opacity: 0.85; }
  .big { position: absolute; right: 8px; top: -0.12em; font-size: clamp(140px, 26vw, 330px); line-height: 1; color: transparent; -webkit-text-stroke: 2px var(--accent); opacity: 0.95; }
  h1 { font-size: clamp(30px, 5.4vw, 64px); line-height: 1.02; margin: 40px 0 12px; max-width: 15ch; }
  .code { display: flex; align-items: center; gap: 12px; margin-top: 22px; font-size: 10px; letter-spacing: 0.2em; }
  .code i { width: 120px; height: 22px; background: repeating-linear-gradient(90deg, var(--fg) 0 2px, transparent 2px 4px, var(--fg) 4px 5px, transparent 5px 8px, var(--fg) 8px 11px, transparent 11px 13px); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 70px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1.5px solid var(--text); border-radius: 4px; text-decoration: none; font: 700 17px/1.3 var(--sans); box-shadow: 5px 5px 0 var(--accent); transition: transform 0.15s, box-shadow 0.15s; }
  .pager a:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--accent); color: inherit; }
  .pager small { font: 600 11px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
  .pager .nx { text-align: right; grid-column: 2; }
  .readbar { position: fixed; z-index: 41; top: 58px; left: 0; right: 0; height: 3px; pointer-events: none; }
  .readbar i { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }

  /* The band prints in: number slides in, title rises out of a slot, barcode scans. */
  @media (prefers-reduced-motion: no-preference) {
    .big { animation: big-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
    .meta { animation: fade-in 0.5s ease 0.1s both; }
    h1 { animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.12s both; }
    .code i { animation: scan 0.8s steps(12) 0.35s both; }
    .code span { animation: fade-in 0.4s ease 0.8s both; }
    .band::after { animation: fade-in 1.2s ease 0.2s both; }
  }
  @keyframes big-in { from { transform: translateX(14%) rotate(4deg); opacity: 0; } }
  @keyframes rise { from { transform: translateY(0.5em); opacity: 0; clip-path: inset(0 0 100% 0); } to { clip-path: inset(-0.2em -0.2em -0.3em -0.2em); } }
  @keyframes scan { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes fade-in { from { opacity: 0; } }
  @media (max-width: 640px) { .band-in { min-height: 230px; } .meta span { display: none; } .big { font-size: 120px; } .pager { grid-template-columns: 1fr; } .pager .nx { grid-column: 1; } }
</style>

<script>
  // Section rail: the open chapter lists its own sections, lit as you read.
  const heads = [...document.querySelectorAll<HTMLElement>(".prose h2[id]")];
  const here = document.querySelector<HTMLElement>(".toc a.on");
  const links = new Map<Element, HTMLAnchorElement>();
  if (here && heads.length) {
    const list = document.createElement("div");
    list.className = "secs";
    for (const h of heads) {
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      a.textContent = h.textContent!.replace(/#$/, "").trim();
      list.append(a);
      links.set(h, a);
    }
    here.after(list);
  }
  // Open the rail at the chapter you are on, not at the top of the list.
  const rail = document.querySelector<HTMLElement>(".toc");
  if (rail && here) rail.scrollTop = here.offsetTop - rail.clientHeight / 3;

  // On phones the rail is a drawer: a pill at the bottom says where you are
  // and pulls the contents up over the page.
  const pill = document.querySelector<HTMLButtonElement>(".railbtn")!;
  const label = pill.querySelector("span");
  const chapterName = label?.textContent ?? "";
  const scrim = document.querySelector<HTMLElement>(".scrim")!;
  function drawer(open: boolean) {
    if (!rail) return;
    rail.classList.toggle("open", open);
    scrim.classList.toggle("on", open);
    pill.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("pv-lock", open);
    if (open) {
      const lit = rail.querySelector<HTMLElement>(".secs a.on") ?? here;
      if (lit) rail.scrollTop = lit.offsetTop - rail.clientHeight / 3;
      rail.querySelector<HTMLElement>(".toc-x")!.focus({ preventScroll: true });
    } else if (document.activeElement && rail.contains(document.activeElement)) pill.focus({ preventScroll: true });
  }
  pill.addEventListener("click", () => drawer(true));
  scrim.addEventListener("click", () => drawer(false));
  rail?.querySelector(".toc-x")!.addEventListener("click", () => drawer(false));
  rail?.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) drawer(false); });
  addEventListener("keydown", (e) => { if (e.key === "Escape" && rail?.classList.contains("open")) drawer(false); });
  // Drag the drawer's head down to put it away.
  const head = rail?.querySelector<HTMLElement>(".toc-head");
  let y0 = -1;
  head?.addEventListener("pointerdown", (e) => { y0 = e.clientY; rail!.style.transition = "none"; });
  addEventListener("pointermove", (e) => { if (y0 >= 0) rail!.style.transform = `translateY(${Math.max(0, e.clientY - y0)}px)`; });
  addEventListener("pointerup", (e) => {
    if (y0 < 0) return;
    const dy = e.clientY - y0;
    y0 = -1;
    rail!.style.transition = rail!.style.transform = "";
    if (dy > 70) drawer(false);
  });
  // Leaving phone width with the drawer open must not leave the page locked.
  matchMedia("(min-width: 901px)").addEventListener("change", (m) => { if (m.matches) drawer(false); });

  // Reading progress under the masthead, and the section you are in.
  const bar = document.querySelector<HTMLElement>(".readbar i")!;
  let ticking = false;
  function onScroll() {
    ticking = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
    let cur: Element | undefined;
    for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.3) cur = h;
    if (label) label.textContent = cur ? links.get(cur)!.textContent : chapterName;
    for (const [h, a] of links) {
      const on = h === cur;
      if (on && !a.classList.contains("on") && rail) {
        // Keep the lit section inside the rail as you read.
        const top = a.offsetTop - rail.scrollTop;
        if (top < 30 || top > rail.clientHeight - 60) rail.scrollTo({ top: a.offsetTop - rail.clientHeight / 3, behavior: "smooth" });
      }
      a.classList.toggle("on", on);
    }
  }
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  // ← and → walk the chapters when nothing else wants the keys.
  addEventListener("keydown", (e) => {
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey || document.querySelector("dialog[open]")) return;
    const t = e.target as HTMLElement;
    if (t.closest("input, textarea, select, [contenteditable], canvas")) return;
    const sel = ({ ArrowRight: ".pager .nx", ArrowLeft: ".pager .pr" } as Record<string, string>)[e.key];
    const a = sel && document.querySelector<HTMLAnchorElement>(sel);
    if (a) location.href = a.href;
  });
</script>
